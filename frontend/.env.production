# GadgetHub Frontend Environment Variables (production build)
# Loaded automatically by Vite when running `vite build` (mode=production).
# IMPORTANT: must include the /api prefix - the Django backend mounts every
# route under /api/ (see backend/gadgethub/urls.py), so omitting it here
# causes every request to 404 against the deployed API.

VITE_API_BASE_URL=https://gadgethub-api-vdcs.onrender.com/api
VITE_APP_URL=https://your-frontend-domain.com
