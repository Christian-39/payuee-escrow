# GadgetHub Frontend Environment Variables

# API URL - Backend server URL

# VITE_API_URL=https://gadgethub-api-vdcs.onrender.com/api

# Optional: Analytics
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=

# .env (local development)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_URL=http://localhost:5173/api

# .env.production (deployed)
VITE_API_BASE_URL=https://gadgethub-api-vdcs.onrender.com
VITE_APP_URL=https://your-frontend-domain.com